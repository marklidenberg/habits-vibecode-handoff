# Apple Developer team id, developer.apple.com/account → Membership
TEAM_ID=

# The app's bundle id, unique to you; its iCloud container: iCloud.<bundle id>
BUNDLE_ID=

# App Store Connect API key, Admin: appstoreconnect.apple.com/access/integrations/api
API_KEY_ID=
API_ISSUER_ID=
API_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_$API_KEY_ID.p8

# The iPhone's UDID: xcrun devicectl device info details --device "<name>" | grep udid
DEVICE_UDID=
